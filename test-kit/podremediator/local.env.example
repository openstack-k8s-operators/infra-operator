# Copy this file to local.env and fill in your values.
# local.env is gitignored — never commit it.
#
# Source before running scripts:
#   source test-kit/podremediator/local.env
# Or export and run:
#   (source test-kit/podremediator/local.env && ./test-kit/podremediator/scripts/run-e2e.sh)
#
# Scripts auto-source this file when it is present in the test-kit/podremediator/ directory.

# FQDN or IP of the libvirt/jump host (required by all scripts)
HAD18=<jump-host-fqdn-or-ip>

# Inventory to use on the jump host. Defaults to inventory-from-jumphost.yml (CHANGEME placeholders).
# Set to the .local.yml variant so the real hostnames are used:
JUMPHOST_INVENTORY=test-kit/podremediator/inventory/inventory-from-jumphost.local.yml

# SSH user on the jump host (default: root)
HAD18_USER=root

# Path where the repo is synced on the jump host (default: /home/zuul/infra-operator)
HAD18_REPO_PATH=/home/zuul/infra-operator

# SSH password for the jump host when not using key auth (used via sshpass).
# Leave unset if using SSH keys.
# SSHPASS=<password>

# Custom infra-operator image for the runbook (required by run-runbook.sh)
CUSTOM_OPERATOR_IMAGE=quay.io/<your-org>/infra-operator@sha256:<digest>

# Path to oc on the controller if not in PATH
# E2E_OC_CMD=/path/to/oc

# API server URL (avoids oc login hang after cluster redeploy)
# OC_API_SERVER=https://api.<cluster>:6443
# E2E_OC_API_SERVER=https://api.<cluster>:6443
